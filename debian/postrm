#!/bin/bash
set -e

# ============================================================================
# LiteLLM-Puter Post-Removal Script
# ============================================================================

USER="litellm"
GROUP="litellm"
INSTALL_DIR="/opt/litellm-puter"
LOG_DIR="/var/log/litellm-puter"
DATA_DIR="/var/lib/litellm-puter"

case "$1" in
    purge)
        echo "Purgando litellm-puter..."

        # Eliminar directorios de datos
        rm -rf "$INSTALL_DIR"
        rm -rf "$LOG_DIR"
        rm -rf "$DATA_DIR"
        rm -rf /etc/default/litellm-puter

        # Eliminar usuario del sistema
        if getent passwd "$USER" > /dev/null 2>&1; then
            echo "Eliminando usuario del sistema: $USER"
            userdel "$USER" || true
        fi

        # Recargar systemd
        systemctl daemon-reload || true

        echo "litellm-puter purgado completamente"
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # No eliminar datos en remove, solo en purge
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
