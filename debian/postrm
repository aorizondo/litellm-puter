#!/bin/bash
set -e

case "$1" in
    purge)
        # Remove user and group
        if getent passwd litellm-puter > /dev/null 2>&1; then
            deluser --system litellm-puter || true
        fi
        
        if getent group litellm-puter > /dev/null 2>&1; then
            delgroup --system litellm-puter || true
        fi
        
        # Remove data directories (but keep configs for potential reinstall)
        rm -rf /var/lib/litellm-puter
        rm -rf /var/log/litellm-puter
        
        # Optionally remove config (ask user or keep for safety)
        if [ -d /etc/litellm-puter ]; then
            echo "Configuration directory /etc/litellm-puter preserved."
            echo "To remove it manually: sudo rm -rf /etc/litellm-puter"
        fi
        
        systemctl daemon-reload || true
        ;;
    
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
