#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop and disable service
        if systemctl is-active --quiet litellm-puter; then
            systemctl stop litellm-puter || true
        fi
        
        if systemctl is-enabled --quiet litellm-puter; then
            systemctl disable litellm-puter || true
        fi
        ;;
    
    failed-upgrade)
        ;;
    
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
