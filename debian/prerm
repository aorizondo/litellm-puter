#!/bin/bash
set -e

# ============================================================================
# LiteLLM-Puter Pre-Removal Script
# ============================================================================

case "$1" in
    remove|upgrade|deconfigure)
        # Detener el servicio si está corriendo
        if systemctl is-active --quiet litellm-puter.service; then
            echo "Deteniendo servicio litellm-puter..."
            systemctl stop litellm-puter.service || true
        fi

        # Deshabilitar el servicio
        if systemctl is-enabled --quiet litellm-puter.service; then
            echo "Deshabilitando servicio litellm-puter..."
            systemctl disable litellm-puter.service || true
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
