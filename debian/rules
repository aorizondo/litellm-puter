#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export PYBUILD_NAME=litellm-puter

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build/
	rm -rf *.egg-info/
	find . -name '*.pyc' -delete
	find . -name '__pycache__' -delete

override_dh_auto_build:
	# No build needed, files will be copied directly

override_dh_auto_install:
	# Install files according to debian/install

override_dh_installinit:
	dh_installinit --name=litellm-puter --no-start

override_dh_systemd_enable:
	dh_systemd_enable --name=litellm-puter litellm-puter.service

override_dh_systemd_start:
	dh_systemd_start --no-start litellm-puter.service
