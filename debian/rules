#!/usr/bin/make -f

export PYBUILD_NAME=litellm-puter
export PATH := $(HOME)/.local/bin:$(PATH)

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	rm -rf build dist *.egg-info .pytest_cache __pycache__
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	dh_auto_clean

override_dh_auto_build:
	poetry build -f wheel
	dh_auto_build

override_dh_auto_install:
	pip3 install --no-deps --target=debian/litellm-puter/usr/lib/python3/dist-packages dist/*.whl
	# Install configuration files
	install -D -m 644 config/litellm_config.yaml debian/litellm-puter/etc/litellm-puter/config.yaml
	install -D -m 600 config/.env.example debian/litellm-puter/etc/litellm-puter/env.example
	# Install systemd service
	install -D -m 644 debian/litellm-puter.service debian/litellm-puter/lib/systemd/system/litellm-puter.service
	# Install documentation
	install -D -m 644 README.md debian/litellm-puter/usr/share/doc/litellm-puter/README.md
	cp -r docs/* debian/litellm-puter/usr/share/doc/litellm-puter/

override_dh_installdocs:
	dh_installdocs

override_dh_installchangelogs:
	dh_installchangelogs

override_dh_compress:
	dh_compress -X.md

override_dh_fixperms:
	dh_fixperms
	chmod 750 debian/litellm-puter/etc/litellm-puter
	chmod 640 debian/litellm-puter/etc/litellm-puter/config.yaml
	chmod 600 debian/litellm-puter/etc/litellm-puter/env.example
