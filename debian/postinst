#!/bin/bash
set -e

case "$1" in
    configure)
        # Create system user and group
        if ! getent group litellm-puter > /dev/null 2>&1; then
            addgroup --system litellm-puter
        fi
        
        if ! getent passwd litellm-puter > /dev/null 2>&1; then
            adduser --system \
                    --ingroup litellm-puter \
                    --home /var/lib/litellm-puter \
                    --no-create-home \
                    --gecos "LiteLLM Puter Service" \
                    --shell /usr/sbin/nologin \
                    litellm-puter
        fi
        
        # Create necessary directories
        mkdir -p /var/lib/litellm-puter
        mkdir -p /var/log/litellm-puter
        mkdir -p /etc/litellm-puter
        
        # Set ownership
        chown -R litellm-puter:litellm-puter /var/lib/litellm-puter
        chown -R litellm-puter:litellm-puter /var/log/litellm-puter
        chown -R root:litellm-puter /etc/litellm-puter
        
        # Set permissions
        chmod 750 /etc/litellm-puter
        chmod 755 /var/lib/litellm-puter
        chmod 755 /var/log/litellm-puter
        
        # Create environment file if it doesn't exist
        if [ ! -f /etc/litellm-puter/environment ]; then
            cat > /etc/litellm-puter/environment << 'EOF'
# LiteLLM Puter Environment Configuration
# Copy this file and add your API keys

# Required: Puter API Key
PUTER_API_KEY=

# Optional: Proxy configuration (uncomment to use)
# USE_PROXY=false
# SOCKS5_PROXY=socks5://proxy.server:port

# Server configuration
HOST=0.0.0.0
PORT=4000
EOF
            chown root:litellm-puter /etc/litellm-puter/environment
            chmod 640 /etc/litellm-puter/environment
            
            echo ""
            echo "=================================================="
            echo "  LiteLLM Puter Gateway installed successfully!"
            echo "=================================================="
            echo ""
            echo "⚠️  IMPORTANT: Configure your API key before starting the service:"
            echo ""
            echo "1. Edit the environment file:"
            echo "   sudo nano /etc/litellm-puter/environment"
            echo ""
            echo "2. Add your Puter API key:"
            echo "   PUTER_API_KEY=your_api_key_here"
            echo ""
            echo "3. Enable and start the service:"
            echo "   sudo systemctl enable litellm-puter"
            echo "   sudo systemctl start litellm-puter"
            echo ""
            echo "4. Check service status:"
            echo "   sudo systemctl status litellm-puter"
            echo ""
            echo "5. View logs:"
            echo "   sudo journalctl -u litellm-puter -f"
            echo ""
            echo "📚 Documentation: /usr/share/doc/litellm-puter/"
            echo "🌐 Gateway will be available at: http://localhost:4000"
            echo "📖 API Docs: http://localhost:4000/docs"
            echo ""
        fi
        
        # Reload systemd
        systemctl daemon-reload || true
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
