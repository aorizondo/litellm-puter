#!/bin/bash
set -e

# ============================================================================
# LiteLLM-Puter Post-Installation Script
# ============================================================================

INSTALL_DIR="/opt/litellm-puter"
CONFIG_DIR="/etc/litellm-puter"
LOG_DIR="/var/log/litellm-puter"
DATA_DIR="/var/lib/litellm-puter"
USER="litellm"
GROUP="litellm"

case "$1" in
    configure)
        echo "Configurando litellm-puter..."

        # Crear usuario del sistema si no existe
        if ! getent passwd "$USER" > /dev/null 2>&1; then
            echo "Creando usuario del sistema: $USER"
            useradd --system --home-dir "$DATA_DIR" --shell /bin/false \
                    --comment "LiteLLM Puter Service" "$USER"
        fi

        # Crear directorios necesarios
        mkdir -p "$INSTALL_DIR"
        mkdir -p "$CONFIG_DIR"
        mkdir -p "$LOG_DIR"
        mkdir -p "$DATA_DIR"
        mkdir -p "$DATA_DIR/cache"

        # Copiar módulo Python
        if [ -d "/usr/share/litellm-puter/litellm_puter" ]; then
            cp -r /usr/share/litellm-puter/litellm_puter "$INSTALL_DIR/"
        fi

        # Copiar configuración si no existe
        if [ ! -f "$CONFIG_DIR/config.yaml" ]; then
            if [ -f "/usr/share/litellm-puter/config.yaml" ]; then
                cp /usr/share/litellm-puter/config.yaml "$CONFIG_DIR/"
                echo "Configuración copiada a $CONFIG_DIR/config.yaml"
            fi
        fi

        # Crear archivo de variables de entorno si no existe
        if [ ! -f "/etc/default/litellm-puter" ]; then
            cat > /etc/default/litellm-puter <<EOF
# LiteLLM-Puter Environment Variables
# Editar este archivo para configurar el servicio

# REQUERIDO: API Key de Puter
# Obtener en: https://puter.com/app/settings/developer
PUTER_API_KEY=

# LiteLLM Configuration
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-1234

# PostgreSQL Database
DATABASE_URL=postgresql://litellm:password@localhost:5432/litellm_db

# Xvfb (para scraper)
USE_XVFB=1
DISPLAY=:99

# Logging
LOG_LEVEL=INFO
EOF
            chmod 600 /etc/default/litellm-puter
            echo "Archivo de configuración creado: /etc/default/litellm-puter"
            echo "IMPORTANTE: Editar /etc/default/litellm-puter y agregar PUTER_API_KEY"
        fi

        # Establecer permisos
        chown -R "$USER:$GROUP" "$INSTALL_DIR"
        chown -R "$USER:$GROUP" "$LOG_DIR"
        chown -R "$USER:$GROUP" "$DATA_DIR"
        chown root:root "$CONFIG_DIR/config.yaml"
        chmod 644 "$CONFIG_DIR/config.yaml"

        # Crear entorno virtual e instalar dependencias
        echo "Instalando dependencias Python..."
        if [ ! -d "$INSTALL_DIR/venv" ]; then
            python3 -m venv "$INSTALL_DIR/venv"
            "$INSTALL_DIR/venv/bin/pip" install --upgrade pip setuptools wheel
            
            # Instalar desde requirements si existe
            if [ -f "/usr/share/litellm-puter/requirements.txt" ]; then
                "$INSTALL_DIR/venv/bin/pip" install -r /usr/share/litellm-puter/requirements.txt
            fi
            
            # Instalar paquetes principales
            "$INSTALL_DIR/venv/bin/pip" install \
                'litellm[proxy]>=1.80.10' \
                'httpx[socks]>=0.28.0' \
                'fastapi>=0.120.1' \
                'uvicorn[standard]>=0.31.1' \
                'patchright>=1.56.0' \
                'xvfbwrapper>=0.2.9' \
                'psycopg2-binary>=2.9.9' \
                'pyyaml>=6.0.2' \
                'python-dotenv>=1.0.1'
            
            # Instalar Playwright browsers
            "$INSTALL_DIR/venv/bin/playwright" install chrome --with-deps || true
        fi

        chown -R "$USER:$GROUP" "$INSTALL_DIR/venv"

        # Recargar systemd
        systemctl daemon-reload

        # Habilitar servicio (pero no iniciar automáticamente)
        systemctl enable litellm-puter.service || true

        echo ""
        echo "============================================"
        echo "LiteLLM-Puter instalado correctamente"
        echo "============================================"
        echo ""
        echo "Próximos pasos:"
        echo ""
        echo "1. Configurar API key de Puter:"
        echo "   sudo nano /etc/default/litellm-puter"
        echo "   # Agregar: PUTER_API_KEY=your_key_here"
        echo ""
        echo "2. Configurar PostgreSQL (si no está configurado):"
        echo "   sudo -u postgres createuser litellm"
        echo "   sudo -u postgres createdb litellm_db -O litellm"
        echo "   sudo -u postgres psql -c \"ALTER USER litellm WITH PASSWORD 'password';\""
        echo ""
        echo "3. Iniciar el servicio:"
        echo "   sudo systemctl start litellm-puter"
        echo ""
        echo "4. Verificar estado:"
        echo "   sudo systemctl status litellm-puter"
        echo "   sudo journalctl -u litellm-puter -f"
        echo ""
        echo "5. Acceder al proxy:"
        echo "   http://localhost:4000"
        echo ""
        echo "Documentación: https://github.com/aorizondo/litellm-puter"
        echo "============================================"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
