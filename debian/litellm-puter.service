[Unit]
Description=LiteLLM Puter AI Gateway
Documentation=https://github.com/aorizondo/litellm-puter
After=network.target postgresql.service redis-server.service
Wants=postgresql.service

[Service]
Type=simple
User=litellm
Group=litellm

# Directorios
WorkingDirectory=/etc/litellm-puter
Environment="PATH=/opt/litellm-puter/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/litellm-puter"

# Variables de entorno desde archivo
EnvironmentFile=/etc/default/litellm-puter

# Comando de inicio
ExecStartPre=/bin/bash -c 'if [ -z "$PUTER_API_KEY" ]; then echo "ERROR: PUTER_API_KEY no configurado en /etc/default/litellm-puter"; exit 1; fi'
ExecStartPre=/bin/bash -c 'if [ "$USE_XVFB" = "1" ]; then rm -f /tmp/.X99-lock; Xvfb :99 -screen 0 1280x1024x24 -ac +extension GLX +render -noreset & sleep 2; fi'
ExecStart=/opt/litellm-puter/venv/bin/litellm \
    --config /etc/litellm-puter/config.yaml \
    --port ${LITELLM_PORT:-4000} \
    --host 0.0.0.0

# Reinicio automático
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Límites de recursos
LimitNOFILE=65536
MemoryLimit=1G
CPUQuota=100%

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/litellm-puter /var/lib/litellm-puter /tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=litellm-puter

# Timeout
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
