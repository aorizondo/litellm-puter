# ============================================================================
# LiteLLM-Puter Environment Variables
# ============================================================================
#
# Copiar este archivo a .env y configurar las variables necesarias:
#   cp .env.example .env
#
# ============================================================================

# ============================================================================
# Puter API Configuration (REQUERIDO)
# ============================================================================
# Obtener API key en: https://puter.com/app/settings/developer
PUTER_API_KEY=your_puter_api_key_here

# ============================================================================
# LiteLLM Configuration
# ============================================================================
# Puerto del servidor proxy
LITELLM_PORT=4000

# Master key para autenticación del proxy
# Cambiar en producción por una clave segura
LITELLM_MASTER_KEY=sk-1234

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_password_change_me
POSTGRES_DB=litellm_db
POSTGRES_PORT=5432

# URL de conexión completa (se construye automáticamente)
# DATABASE_URL=postgresql://litellm:password@localhost:5432/litellm_db

# Optimizaciones de PostgreSQL
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
POSTGRES_MAX_CONNECTIONS=50

# ============================================================================
# Redis Cache (Opcional)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAXMEMORY=64mb

# ============================================================================
# Xvfb y Chrome (para scraper)
# ============================================================================
USE_XVFB=1
DISPLAY=:99
CHROME_BIN=/usr/bin/google-chrome-stable

# ============================================================================
# Performance y Recursos
# ============================================================================
# Workers de Uvicorn
UVICORN_WORKERS=2

# Límites de recursos para Docker
# LiteLLM
LITELLM_MEMORY_LIMIT=512M
LITELLM_CPU_LIMIT=0.5
LITELLM_MEMORY_RESERVATION=256M
LITELLM_CPU_RESERVATION=0.25

# PostgreSQL
POSTGRES_MEMORY_LIMIT=256M
POSTGRES_CPU_LIMIT=0.3
POSTGRES_MEMORY_RESERVATION=128M
POSTGRES_CPU_RESERVATION=0.15

# Redis
REDIS_MEMORY_LIMIT=128M
REDIS_CPU_LIMIT=0.2

# ============================================================================
# Proxy Configuration (Opcional)
# ============================================================================
# Habilitar proxy para scraper
USE_PROXY=false

# Configurar proxy SOCKS5 o HTTP
# SOCKS5_PROXY=socks5://localhost:1080
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080

# ============================================================================
# Logging y Monitoring (Opcional)
# ============================================================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Langfuse (opcional, para observabilidad)
# LANGFUSE_PUBLIC_KEY=your_public_key
# LANGFUSE_SECRET_KEY=your_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# Development
# ============================================================================
# Modo debug
DEBUG=false

# Recargar automáticamente en cambios
AUTO_RELOAD=false
